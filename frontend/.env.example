# Copy to .env.local. NEVER commit real secrets.
# This server fallback key must be the treasury-holder key because the Tessera contract
# requires treasury_holder.require_auth(). Prefer Freighter wallet signing in demos.
TESSERA_TREASURY_SECRET=

# Contract + RPC (set after fresh deployment)
TESSERA_CONTRACT_ID=REPLACE_AFTER_DEPLOY
NEXT_PUBLIC_TESSERA_CONTRACT_ID=REPLACE_AFTER_DEPLOY
RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_NETWORK=testnet

# Legacy compat (read once, then removed)
# ISSUER_SECRET=
# CONTRACT_ID=
# NEXT_PUBLIC_CONTRACT_ID=